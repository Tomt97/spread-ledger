rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master account: replace with your user ID (shown on the site after you sign up).
    function isOwner() {
      return request.auth != null && request.auth.uid == "owe2stqvSHZFvSqISvgwsh7tLUg2";
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isApproved(uid) {
      return get(/databases/$(database)/documents/members/$(uid)).data.status == "approved";
    }

    match /members/{uid} {
      // The member record holds sign-up info and approval status.
      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      // New sign-ups can only create themselves as "pending".
      allow create: if isOwner() || (isSelf(uid)
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly(["joinedAt", "name", "email", "status"]));
      // Only the owner approves, declines or suspends.
      allow update: if isOwner();
      // Members may delete their own membership.
      allow delete: if isSelf(uid) || isOwner();

      // Trades, accounts and market inputs: the owner, or the member once approved.
      match /{rest=**} {
        allow read, write: if isOwner() || (isSelf(uid) && isApproved(uid));
      }
    }

    // Read-only share pages: anyone with the link can read one summary; only its creator can change it.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && (isOwner() || isApproved(request.auth.uid));
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Ticker symbols that have open trades (symbols only, nothing about who holds them), so the
    // "Update option quotes" GitHub Action knows which option chains to fetch.
    match /tickers/{sym} {
      allow read: if true;
      allow create, update: if request.auth != null
        && (isOwner() || isApproved(request.auth.uid))
        && sym.matches('[A-Z0-9.]{1,8}')
        && request.resource.data.keys().hasOnly(["at"])
        && request.resource.data.at is int;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
